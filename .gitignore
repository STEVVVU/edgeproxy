# Certificates and keys are never committed. The TLS tests generate throwaway
# self-signed pairs into a temp directory at run time, and the benchmark and demo
# scripts generate one into benchmark/tls/ and demo/tls/, so nothing here needs
# versioning.
benchmark/tls/
*.pem
*.crt
*.key

# Generated by scripts/demo.ps1: config, logs, and certificate for the local
# demo topology. demo/prometheus.yml is hand-written and IS committed.
/demo/edgeproxy.demo.toml
/demo/tls/

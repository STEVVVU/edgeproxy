# Builds the deterministic upstream fixture used by compose.yaml.
#
# Separate from the main Dockerfile because the fixture is a cargo *example*, not
# a bin, and shipping it inside the proxy image would put test scaffolding into
# the runtime image.

FROM rust:1.86-bookworm AS builder

WORKDIR /build

COPY Cargo.toml Cargo.lock ./
COPY src ./src
COPY benches ./benches
COPY examples ./examples

RUN cargo build --release --locked --example fixture_upstream \
    && strip target/release/examples/fixture_upstream

FROM gcr.io/distroless/cc-debian12:nonroot

USER nonroot:nonroot

COPY --from=builder /build/target/release/examples/fixture_upstream \
    /usr/local/bin/fixture_upstream

EXPOSE 8000

ENTRYPOINT ["/usr/local/bin/fixture_upstream"]
